{
  "telegram": {
    "bot_token": "YOUR_BOT_TOKEN",
    "allowed_user_ids": [],
    "targets": [],
    "parse_mode": "HTML",
    "disable_web_page_preview": false,
    "footer_text": ""
  },
  "news_sources": {
    "rss_feeds": [
      "https://www.rbc.ru/rss/news.rss",
      "https://habr.com/ru/rss/all/all/?fl=ru",
      "https://tass.ru/rss/v2.xml",
      "https://ria.ru/export/rss2/index.xml",
      "https://www.kommersant.ru/rss/news.xml"
    ],
    "newsapi": {
      "enabled": false,
      "api_key": "YOUR_NEWSAPI_KEY",
      "categories": [
        "technology",
        "science"
      ],
      "language": "ru",
      "page_size": 30,
      "country": "ru"
    },
    "gnews": {
      "enabled": false,
      "api_key": "YOUR_GNEWS_KEY",
      "categories": [
        "technology",
        "science"
      ],
      "language": "ru",
      "page_size": 10,
      "country": "ru"
    },
    "mediastack": {
      "enabled": false,
      "api_key": "YOUR_MEDIASTACK_KEY",
      "categories": [
        "technology",
        "science"
      ],
      "language": "ru",
      "page_size": 30
    },
    "custom": []
  },
  "digest": {
    "items_count": 6,
    "russia_focused": 5,
    "international": 1,
    "keywords": [
      "Россия",
      "РФ",
      "Роскомнадзор",
      "РКН",
      "VPN",
      "Telegram",
      "телеграм",
      "технологии",
      "IT",
      "интернет",
      "кибербезопасность"
    ],
    "exclude_keywords": [
      "спорт",
      "шоу-бизнес",
      "знаменитости"
    ],
    "lookback_hours": 48,
    "max_candidates_for_llm": 20,
    "dedup_similarity": 0.86,
    "memory_days": 30,
    "max_llm_calls_per_run": 8,
    "max_input_chars_per_item": 2200,
    "inline_url": true,
    "show_source": true,
    "mode": "single"
  },
  "images": {
    "enabled": false,
    "provider": "unsplash",
    "access_key": "YOUR_UNSPLASH_ACCESS_KEY",
    "orientation": "landscape",
    "per_post": true
  },
  "network": {
    "public_proxy_fallback": {
      "enabled": true,
      "file": "data/proxies/socks5.txt",
      "timeout_ms": 12000
    }
  },
  "schedule": {
    "cron": "0 * * * *",
    "timezone": "Europe/Moscow",
    "interval_min_minutes": 30,
    "interval_max_minutes": 60
  },
  "clodex": {
    "enabled": true,
    "api_key": "YOUR_CLODEX_API_KEY",
    "base_url": "https://clodex.xyz/v1",
    "model": "YOUR_CLODEX_MODEL",
    "timeout_ms": 45000,
    "max_output_tokens": 1400,
    "temperature": 0.2
  },
  "google_ai": {
    "enabled": false,
    "api_key": "YOUR_GOOGLE_AI_STUDIO_API_KEY",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "model": "gemini-2.5-flash-lite",
    "timeout_ms": 90000,
    "max_output_tokens": 8192,
    "temperature": 0.2
  },
  "monitoring": {
    "currency": {
      "usd_rub": 90
    },
    "clodex": {
      "usd_per_million_tokens": 0.1
    },
    "free_limits": {
      "newsapi": {
        "requests": 100,
        "period": "day",
        "url": "https://newsapi.org/pricing",
        "note": "Developer: 100 requests/day; development/testing only",
        "api_key": "YOUR_NEWSAPI_KEY"
      },
      "gnews": {
        "requests": 100,
        "period": "day",
        "url": "https://gnews.io/pricing",
        "note": "Free: 100 requests/day; development/testing only",
        "api_key": "YOUR_GNEWS_KEY"
      },
      "mediastack": {
        "requests": 100,
        "period": "month",
        "url": "https://mediastack.com/pricing",
        "note": "Free: 100 calls/month",
        "api_key": "YOUR_MEDIASTACK_KEY"
      },
      "clodex": {
        "requests": 0,
        "period": "provider",
        "url": "https://clodex.xyz/docs",
        "note": "Лимит зависит от выбранного тарифа/модели; бот считает локальное потребление токенов"
      }
    }
  },
  "web": {
    "enabled": false,
    "port": 3000,
    "host": "0.0.0.0",
    "domain": "",
    "password": "CHANGE_ME_ADMIN_PASSWORD",
    "auto_ssl": true,
    "ssl_email": "",
    "random_port": true,
    "duckdns": {
      "enabled": false,
      "domain": "",
      "token": "",
      "interval_minutes": 5
    }
  },
  "ai": {
    "provider": "clodex",
    "format": "rich_html"
  },
  "openai": {
    "enabled": true,
    "api_key": "YOUR_OPENAI_API_KEY",
    "model": "gpt-6-luna",
    "timeout_ms": 90000,
    "max_output_tokens": 8192
  },
  "updates": {
    "enabled": true,
    "autoInstall": true,
    "intervalSeconds": 60,
    "repository": "romanich237/NewsDigestBot",
    "branch": "main"
  },
  "custom": {
    "enabled": true,
    "base_url": "https://api.example.com/v1",
    "api_key": "YOUR_CUSTOM_API_KEY",
    "model": "YOUR_CUSTOM_MODEL",
    "timeout_ms": 90000,
    "max_output_tokens": 8192,
    "token_parameter": "max_tokens",
    "temperature": null
  },
  "setup": {
    "completed": false
  }
}
